# Copy to .env (repo root or backend/) and fill in the key.
GEMINI_API_KEY=
# Gemini is called through its OpenAI-compatible endpoint.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# 3.6 Flash is the default because 3.8 Flash sees very high demand.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional overrides
# ASANAS_PATH=backend/asanas.json
# PUBLIC_DIR=public
# MAX_UPLOAD_BYTES=4194304
# MAX_IMAGE_DIMENSION=1024
# Per-attempt timeout; the fallback model gets its own attempt.
# REQUEST_TIMEOUT_S=25
